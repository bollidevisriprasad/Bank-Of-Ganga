{
  "name": "DSP Bank (Java 17 + Maven)",
  "image": "mcr.microsoft.com/devcontainers/java:1-17-bookworm",
  "features": { "ghcr.io/devcontainers/features/java:1": { "version": "17", "installMaven": "true" } },
  "forwardPorts": [8080],
  "portsAttributes": { "8080": { "label": "DSP Bank", "onAutoForward": "openBrowser" } },
  "customizations": { "vscode": { "extensions": ["vscjava.vscode-java-pack", "vmware.vscode-boot-dev-pack"] } }
}
